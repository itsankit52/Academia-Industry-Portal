# ==============================================================================
# Academia-Industry Collaboration Portal — Environment Variables Example
# ------------------------------------------------------------------------------
# 1. Copy this file to .env at the repo root and inside apps/api and apps/web.
# 2. Fill in real values from MongoDB Atlas, Cloudinary, and Google AI Studio.
# 3. NEVER commit real secrets. Rotate any accidentally-committed value.
# ==============================================================================

# ---- Runtime ----
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ---- MongoDB Atlas ----
# Free tier: https://www.mongodb.com/cloud/atlas/register
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=academia_industry_portal

# ---- JWT ----
# Generate strong secrets: `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_ACCESS_SECRET=replace_with_64_random_hex_chars
JWT_REFRESH_SECRET=replace_with_DIFFERENT_64_random_hex_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Cookies ----
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---- Cloudinary (resume/logo storage) ----
# Free tier: https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Google Gemini (AI features) ----
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Webhook HMAC secrets (leave blank to disable each webhook with 503) ----
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
WEBHOOK_LMS_SECRET=
WEBHOOK_ERP_SECRET=

# ---- Upload constraints ----
MAX_FILE_SIZE_MB=5

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---- Logging ----
LOG_LEVEL=info

# ==============================================================================
# Frontend (Vite) — ONLY VITE_ prefixed vars are exposed to the browser.
# NEVER put JWT_*, MONGODB_*, CLOUDINARY_SECRET, or GEMINI_API_KEY behind VITE_.
# ==============================================================================
VITE_API_URL=http://localhost:4000/api/v1
VITE_APP_NAME=Academia-Industry Portal
