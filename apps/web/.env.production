
# Values used by `vite build` (mode "production"), which is what the deployed
# static site is built with. `import.meta.env.VITE_API_URL` is inlined into the
# bundle, so changing this requires a rebuild rather than a restart.
#
# Committed on purpose: `.env` is gitignored, so without this file a production
# build has no API base URL unless the host happens to define one. A real
# environment variable still takes precedence over this file.
VITE_API_URL=https://academia7.onrender.com/api/v1