# apps/api/.env.example — Backend runtime configuration.
# Copy to apps/api/.env and fill in real values. Never commit real secrets.

NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=academia_industry_portal

JWT_ACCESS_SECRET=replace_with_64_random_hex_chars
JWT_REFRESH_SECRET=replace_with_DIFFERENT_64_random_hex_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

MAX_FILE_SIZE_MB=5

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

LOG_LEVEL=info
